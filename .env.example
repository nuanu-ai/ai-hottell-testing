# Run ./scripts/setup.sh to generate .env with unique database passwords.
HT_PUBLIC_ORIGIN=http://localhost:8080
HT_BIND_ADDRESS=127.0.0.1
HT_PORT=8080
HT_COOKIE_SECURE=false
HT_WEBAUTHN_RP_ID=localhost
# HTTPS overlay only: set your own DNS name, no scheme or path.
HT_DOMAIN=
HT_POSTGRES_PASSWORD=
HT_CLICKHOUSE_PASSWORD=
HT_CLICKHOUSE_READER_PASSWORD=
HT_BOOTSTRAP_EMAIL=
HT_BOOTSTRAP_NAME=
HT_BOOTSTRAP_PASSWORD=
