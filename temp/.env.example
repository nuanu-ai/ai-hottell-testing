HT_HTTP_ADDR=:8080
HT_DATABASE_URL=postgres://ht:ht@localhost:5432/ht?sslmode=disable
HT_LOG_LEVEL=info
HT_SHUTDOWN_TIMEOUT=15s
HT_PUBLIC_ORIGIN=http://localhost:8080
HT_COOKIE_SECURE=false
HT_WEBAUTHN_RP_ID=localhost
HT_WEBAUTHN_RP_ORIGINS=http://localhost:8080,http://localhost:5173
HT_COLLECTOR_URL=http://localhost:14318
# /install.sh and /download/* are taken from the latest hottell-v* release of this repository
HT_GITEA_URL=https://git.alva.dev
HT_GITEA_REPO=alva/harness-telemetry
# Gitea token with read access to the repository; set it in .env, never commit it
HT_GITEA_TOKEN=

# task user:create-first
HT_BOOTSTRAP_EMAIL=
HT_BOOTSTRAP_NAME=
HT_BOOTSTRAP_PASSWORD=

# task user:set-password
HT_USER_EMAIL=
HT_USER_PASSWORD=
