{
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{BINARY}} -agent claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/guard.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{BINARY}} -agent claude"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo {{BINARY}} -agent claude >> /tmp/prompts.log"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$ORCA_PANE_KEY\" ]; then payload=$(cat); printf '%s' \"$payload\" | curl -s -m 2 -X POST -H 'Content-Type: application/json' --data-binary @- \"http://127.0.0.1:${ORCA_AGENT_HOOK_PORT}/hook?pane=$ORCA_PANE_KEY\" >/dev/null 2>&1 || true; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "say done"
          },
          {
            "type": "command",
            "command": "{{BINARY}} -agent claude -config x"
          }
        ]
      }
    ]
  }
}
