{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "FOO": "bar & <baz>",
    "LIMIT": 1.50
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/guard.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "say bye"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/jj-worktree.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status)"
    ],
    "deny": []
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "caf\u00e9 --line",
    "padding": 0
  },
  "big": 12345678901234567890
}
