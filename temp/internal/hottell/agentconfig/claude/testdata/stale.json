{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "*",
				"hooks": [
					{"type": "command", "command": "/old/place/hottell hook claude", "async": true},
					{"type": "command", "command": "~/bin/guard.sh"}
				]
			},
			{"hooks": [{"type": "command", "command": "/old/place/hottell hook claude"}]}
		],
		"WorktreeCreate": [
			{"hooks": [{"type": "command", "command": "/old/place/hottell hook claude"}]}
		],
		"SessionEnd": [
			{"hooks": [{"type": "command", "command": "/old/place/hottell hook claude", "timeout": 30}]}
		]
	},
	"model": "sonnet"
}
