{
  "description": "Hooks of the user and of other tools",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/audit-bash --strict",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dev/.local/bin/hottell hook codex >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "say done",
            "async": true
          },
          {
            "type": "command",
            "command": "echo hottell hook codex is someone else's"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dev/.local/bin/hottell hook codex >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/notify start",
            "statusMessage": "Starting <notify> & co"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/notify resume"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dev/.local/bin/hottell hook codex >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dev/.local/bin/hottell hook codex >/dev/null 2>&1 || true",
            "timeout": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dev/.local/bin/hottell hook codex >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dev/.local/bin/hottell hook codex >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dev/.local/bin/hottell hook codex >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dev/.local/bin/hottell hook codex >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dev/.local/bin/hottell hook codex >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dev/.local/bin/hottell hook codex >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dev/.local/bin/hottell hook codex >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dev/.local/bin/hottell hook codex >/dev/null 2>&1 || true",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
